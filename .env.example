# Copiar a .env y completar. NO commitear .env.

# --- Meta / WhatsApp Cloud API ---
# Verify token: string aleatorio que vos elegis (se usa en el webhook de Meta).
WA_VERIFY_TOKEN=cambiar_token_aleatorio_123
# Token permanente: developers.facebook.com -> App -> WhatsApp -> API Setup (System User).
WA_ACCESS_TOKEN=cambiar_token_muy_largo
# Id numerico del numero (WhatsApp -> API Setup -> Phone number ID).
WA_PHONE_NUMBER_ID=cambiar_id_numerico
# Nombre de un template HSM aprobado (para la campana broadcast).
WA_TEMPLATE_BIENVENIDA=saludo_inicial
# Key secreta del endpoint de envio manual (header X-Api-Key en /webhook/wa-send).
WA_SEND_KEY=cambiar_otro_token_random

# --- IA opcional (OpenRouter) ---
# Sin key el bot funciona igual (reglas SQL de bot_rules).
# 1) openrouter.ai -> Sign up gratis -> Keys -> Create key
# 2) Modelos gratuitos actuales: https://openrouter.ai/models?max_price=0
OPENROUTER_API_KEY=
LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Contexto de empresa para la IA (se inyecta en el prompt sistema)
EMPRESA_CTX=Indumentaria El Cholo - Horarios Lun-Vie 9-18 sab 9-13 - Turnos sin turno previo - Av Ejemplo 1234

# --- Base de datos local (postgres del compose) ---
POSTGRES_PASSWORD=cambiar_password_db

# --- Solo si usas Supabase NUBE en vez del postgres local ---
# SUPABASE_URL=https://xxxxxxxx.supabase.co
# SUPABASE_SERVICE_KEY=eyJ...
# SUPABASE_ANON_KEY=eyJ...