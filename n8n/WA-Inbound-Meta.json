              "leftValue": "={{ $json.need_llm }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "9ca497d6-d6ca-4eeb-9878-659f9fb0512d",
      "name": "IF Pide IA",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        2100,
