      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1900,
        250
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, keywords, response, priority\nFROM crm.bot_rules\nWHERE active = true\nORDER BY priority ASC, id ASC;",
        "options": {}
      },
      "id": "c0d99607-5cc8-4bcf-859a-dbf0e1b088bf",
      "name": "Cargar Reglas Bot",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        1700,
        60
      ]
    },
    {
      "parameters": {
        "jsCode": "const msg = $input.first().json;\nconst rules = $('Cargar Reglas Bot').all();\nconst text = (msg.text_body || '').toLowerCase();\nlet reply = null;\nfor (const r of rules) {\n  const kws = (r.json.keywords || '').split(',').map(k => k.trim().toLowerCase()).filter(Boolean);\n  if (kws.some(k => text.includes(k))) { reply = r.json.response; break; }\n}\nconst hasKey = !!(process.env.OPENROUTER_API_KEY || '');\nlet need_llm = false;\nif (!reply) {\n  if (hasKey) {\n    need_llm = true;\n  } else if (/^(hola|buenas|buen dia|buenos dias|hello|hey)/.test(text)) {\n    reply = 'Hola! Gracias por escribirnos. Como podemos ayudarte?';\n  } else {\n    reply = 'Hola, gracias por escribirnos. Un asesor te respondera a la brevedad.';\n  }\n}\nreturn [{ json: { ...msg, reply, need_llm } }];"
      },
      "id": "d361c059-91d4-4480-a318-1e2a782a2d43",
      "name": "Decidir Respuesta Bot",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1900,
        60
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
