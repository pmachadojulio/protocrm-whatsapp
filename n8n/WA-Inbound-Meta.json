      "id": "43d2cfd3-01b6-4ca0-9a1b-ea55dd009292",
      "name": "Responder Challenge",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        440,
        -180
      ]
