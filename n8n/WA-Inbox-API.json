    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE crm.conversations SET bot_handled = CASE WHEN '{{ $json.query.action }}' IN ('bot','reanudar') OR '{{ $json.body.action }}' IN ('bot','reanudar') THEN 1 ELSE 0 END,\n status = CASE WHEN '{{ $json.query.action }}' IN ('bot','reanudar') OR '{{ $json.body.action }}' IN ('bot','reanudar') THEN 'bot' ELSE 'open' END,\n updated_at=now(), last_message_at=now()\nWHERE id='{{ $json.query.conv_id }}{{ $json.body.conv_id }}' RETURNING id, bot_handled, status;",
        "options": {}
      },
