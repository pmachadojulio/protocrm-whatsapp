        "query": "SELECT id::text, conversation_id::text, direction, message_type, body, media_url, created_at\nFROM crm.messages\nWHERE conversation_id = '{{ $json.query.conv_id }}'\nORDER BY created_at ASC\nLIMIT 200;",
